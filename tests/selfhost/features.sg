print(length(people))
for person in people
    print(person["name"] + " " + to_string(person["age"]) + " " + person["city"] + " " + to_string(person["zip"]))
import "data/scores.tsv" as scores
print(scores)
import "data/settings.env" as settings
print(settings)
import "data/constants.py" as py
print(py)
import "data/notes.txt"
print(split(trim(notes), "\n"))
print(load_error("tests/selfhost/data/config.json") == "")
print(load_error("missing.json"))

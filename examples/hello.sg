print("=== FUNCTION CALLS IN EXPRESSIONS ===")

fun double(x)
    return x + x

fun triple(x)
    return x * 3

print(double(5))
print(triple(5))

result = double(10) + 5
print(result)

result = triple(4) * 2
print(result)

print("")

print("=== NESTED FUNCTION CALLS ===")

fun quadruple(x)
    return double(double(x))

print(quadruple(5))

fun add_three(a, b, c)
    return a + b + c

print(add_three(10, 20, 30))

print("")

print("=== CONDITIONAL RETURNS ===")

fun classify(x)
    if x > 10
        return 1
    elif x > 5
        return 2
    elif x > 0
        return 3
    else
        return 4

print(classify(15))
print(classify(8))
print(classify(3))
print(classify(0))

print("")

print("=== EARLY RETURN ===")

fun absolute(x)
    if x < 0
        return 0 - x

    return x

print(absolute(-15))
print(absolute(15))
print(absolute(-1))
print(absolute(1))

print("")

print("=== LOCAL FUNCTION SCOPE ===")

fun scoped_test
    local_value = 123
    print(local_value)

scoped_test()

print("")


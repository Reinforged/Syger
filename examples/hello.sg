print("=== COMPLEX EXPRESSIONS ===")

a = 10
b = 5
c = 2

result = a + b * c
print(result)

result = (a + b) * c
print(result)

result = a > b and b > c
print(result)

result = a < b or b > c
print(result)

result = not (a < b)
print(result)

print("")

print("=== FUNCTIONS + LOOPS ===")

fun sum_to(limit)
    total = 0
    counter = 1

    while counter <= limit
        total = total + counter
        counter = counter + 1

    return total

print(sum_to(5))
print(sum_to(10))

print("")

print("=== FUNCTIONS + CONDITIONALS + LOOPS ===")

fun find_first_large(limit)
    counter = 0

    while counter < limit
        counter = counter + 1

        if counter > 7
            return counter

    return 0

print(find_first_large(10))
print(find_first_large(5))

print("")

print("=== BIG COMBINED TEST ===")

fun calculate(a, b)
    total = add(a, b)

    if total > 50
        return total * 2
    elif total > 20
        return total + 10
    else
        return total

print(calculate(10, 5))
print(calculate(15, 10))
print(calculate(30, 25))

print("")

print("=== ALL TESTS COMPLETE ===")

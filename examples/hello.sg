print("=== IF / ELSE ===")

if true
    print("if: true")

if false
    print("if: false")
else
    print("else: reached")

if 10 > 5
    print("comparison: true")
else
    print("comparison: false")

if 10 < 5
    print("comparison: false")
else
    print("comparison: true")

print("")

print("=== ELIF ===")

value = 15

if value > 20
    print("greater than 20")
elif value > 10
    print("greater than 10")
elif value > 5
    print("greater than 5")
else
    print("5 or less")

value = 8

if value > 20
    print("wrong")
elif value > 10
    print("wrong")
elif value > 5
    print("8 is between 5 and 10")
else
    print("wrong")

value = 2

if value > 20
    print("wrong")
elif value > 10
    print("wrong")
elif value > 5
    print("wrong")
else
    print("2 is 5 or less")

print("")

print("=== WHILE LOOPS ===")

counter = 0

while counter < 5
    print(counter)
    counter = counter + 1

print("loop finished")

print("")

print("=== WHILE + CONTINUE ===")

counter = 0

while counter < 10
    counter = counter + 1

    if counter == 3
        continue

    if counter == 6
        continue

    print(counter)

print("continue finished")

print("")

print("=== WHILE + BREAK ===")

counter = 0

while counter < 10
    counter = counter + 1

    if counter == 6
        break

    print(counter)

print("break finished")

print("")

print("=== NESTED CONTROL FLOW ===")

outer = 0

while outer < 3
    outer = outer + 1

    inner = 0

    while inner < 3
        inner = inner + 1

        if inner == 2
            continue

        print(outer * 10 + inner)

print("nested loops finished")

print("")


print("=== NONE ===")

value = none
print(value)
print(value == none)
print(value != none)

fun no_value()
    return none

result = no_value()
print(result)
print(result == none)

print("")

print("=== STRING OPERATIONS ===")

name = "Reinforged"
greeting = "Hello, " + name
print(greeting)

first_word = "Hello"
second_word = "world"
combined = first_word + " " + second_word
print(combined)

print("hello" == "hello")
print("hello" == "world")
print("hello" != "world")
print("hello" != "hello")
print(length("Hello"))

fun make_greeting(name)
    return "Hello, " + name

print(make_greeting("Syger"))

print("")

print("=== ARRAYS ===")

numbers = [10, 20, 30, 40]

print(numbers)
print(numbers[0])
print(numbers[2])
print(numbers[3])

numbers[1] = 99
print(numbers[1])
print(numbers)

empty = []
print(empty)

mixed = [42, "hello", true]
print(mixed)
print(mixed[0])
print(mixed[1])
print(mixed[2])

nested = [[10, 20], [30, 40]]

print(nested)
print(nested[0])
print(nested[0][0])
print(nested[0][1])
print(nested[1][0])
print(nested[1][1])

nested[1][0] = 77

print(nested[1][0])
print(nested)

fun first(items)
    return items[0]

print(first(numbers))

fun get_nested(items)
    return items[1][1]

print(get_nested(nested))

print("")

print("=== ARRAY UTILITIES ===")

values = [4, 1, 3, 2]

print(length(values))
print(first(values))
print(last(values))
print(contains(values, 3))
print(contains(values, 9))
print(index_of(values, 3))
print(index_of(values, 9))
print(sum(values))
print(min(values))
print(max(values))

append(values, 5)
print(values)

popped = pop(values)
print(popped)
print(values)

insert(values, 1, 9)
print(values)

removed = remove(values, 1)
print(removed)
print(values)

reverse(values)
print(values)

sort(values)
print(values)

part = slice(values, 1, 3)
print(part)

words = ["one", "two", "three"]
print(join(words, ", "))

clear(values)
print(values)

matrix = [[1, 2], [3, 4]]
append(matrix[0], 9)
print(matrix)

print("")


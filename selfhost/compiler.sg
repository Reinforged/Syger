# Syger's first self-hosted compiler.
# It parses Syger source and emits C that uses the small Syger native runtime.
# The bootstrap interpreter is used for stage0; the generated compiler can then
# compile this same file again for stage1/stage2 bootstrap verification.

# ---- error reporting -------------------------------------------------------
# Errors use the same format as the interpreter and the native runtime.

fun repeat_text(text, count)
    result = ""
    i = 0
    while i < count
        result = result + text
        i = i + 1
    return result

fun source_line_text(line)
    current = 1
    i = 0
    n = length(source_text)
    while i < n and current < line
        if char_at(source_text, i) == NL
            current = current + 1
        i = i + 1
    start = i
    while i < n and char_at(source_text, i) != NL and char_at(source_text, i) != chr(13)
        i = i + 1
    return substring(source_text, start, i)

fun compile_error(code, line, message, help)
    if length(message) > 0 and char_at(message, length(message) - 1) == "."
        message = substring(message, 0, length(message) - 1)
    eprint("error[" + code + "]: " + message)
    pad = repeat_text(" ", length(to_string(line)))
    if line > 0
        eprint(pad + "--> " + source_path + ":" + to_string(line))
        eprint(pad + " |")
        eprint(to_string(line) + " | " + source_line_text(line))
        eprint(pad + " |")
    if help != ""
        eprint(pad + " = help: " + help)
    exit(1)
    return none

fun edit_distance(a, b)
    if length(a) > 40 or length(b) > 40
        return 1000
    previous = []
    j = 0
    while j <= length(b)
        append(previous, j)
        j = j + 1
    i = 1
    while i <= length(a)
        current = [i]
        j = 1
        while j <= length(b)
            cost = 1
            if char_at(a, i - 1) == char_at(b, j - 1)
                cost = 0
            best = previous[j - 1] + cost
            if previous[j] + 1 < best
                best = previous[j] + 1
            if current[j - 1] + 1 < best
                best = current[j - 1] + 1
            append(current, best)
            j = j + 1
        previous = current
        i = i + 1
    return previous[length(b)]

fun suggestion(name, candidates, fallback)
    limit = 3
    if length(name) <= 3
        limit = 1
    elif length(name) <= 6
        limit = 2
    best = ""
    best_distance = limit + 1
    i = 0
    while i < length(candidates)
        candidate = candidates[i]
        if candidate != name
            distance = edit_distance(name, candidate)
            if distance < best_distance
                best = candidate
                best_distance = distance
        i = i + 1
    if best == ""
        return fallback
    return "did you mean '" + best + "'?"

fun string_chars(text)
    result = []
    i = 0
    while i < length(text)
        append(result, char_at(text, i))
        i = i + 1
    return result

fun is_digit(character)
    return contains(digit_chars, character)

fun is_letter(character)
    return contains(lowercase_chars, character) or contains(uppercase_chars, character)

fun is_identifier_start(character)
    return is_letter(character) or character == "_"

fun is_identifier_part(character)
    return is_identifier_start(character) or is_digit(character)

fun keyword_type(word)
    if word == "if"
        return "IF"
    elif word == "else"
        return "ELSE"
    elif word == "elif"
        return "ELIF"
    elif word == "while"
        return "WHILE"
    elif word == "fun" or word == "def" or word == "function"
        return "FUNCTION"
    elif word == "return"
        return "RETURN"
    elif word == "break"
        return "BREAK"
    elif word == "continue"
        return "CONTINUE"
    elif word == "true"
        return "TRUE"
    elif word == "false"
        return "FALSE"
    elif word == "none"
        return "NONE"
    elif word == "and"
        return "AND"
    elif word == "or"
        return "OR"
    elif word == "not"
        return "NOT"
    return "IDENTIFIER"

fun scan_tokens(source)
    state = [source, 0, 1, true, [0], []]
    tokens = state[5]
    while state[1] < length(state[0])
        if state[3]
            indentation = 0
            while char_at(state[0], state[1]) == " " or char_at(state[0], state[1]) == chr(9)
                if char_at(state[0], state[1]) == " "
                    indentation = indentation + 1
                else
                    indentation = indentation + 4
                state[1] = state[1] + 1
            character = char_at(state[0], state[1])
            if character == chr(10)
                state[1] = state[1] + 1
                state[2] = state[2] + 1
                continue
            if character == "#"
                while state[1] < length(state[0]) and char_at(state[0], state[1]) != chr(10)
                    state[1] = state[1] + 1
                if char_at(state[0], state[1]) == chr(10)
                    state[1] = state[1] + 1
                    state[2] = state[2] + 1
                continue
            current_indent = state[4][length(state[4]) - 1]
            if indentation > current_indent
                append(state[4], indentation)
                append(tokens, ["INDENT", "", state[2]])
            elif indentation < current_indent
                while length(state[4]) > 1 and indentation < current_indent
                    pop(state[4])
                    append(tokens, ["DEDENT", "", state[2]])
                    current_indent = state[4][length(state[4]) - 1]
                if indentation != current_indent
                    compile_error("E1002", state[2], "inconsistent indentation", "use the same number of spaces as the block this line belongs to")
            state[3] = false

        character = char_at(state[0], state[1])
        if character == " " or character == chr(9) or character == chr(13)
            state[1] = state[1] + 1
            continue
        if character == chr(10)
            state[1] = state[1] + 1
            state[2] = state[2] + 1
            state[3] = true
            continue
        if character == "#"
            while state[1] < length(state[0]) and char_at(state[0], state[1]) != chr(10)
                state[1] = state[1] + 1
            continue

        start_position = state[1]
        start_line = state[2]
        if character == quote_character
            state[1] = state[1] + 1
            string_start = state[1]
            while state[1] < length(state[0]) and char_at(state[0], state[1]) != quote_character
                if char_at(state[0], state[1]) == chr(10)
                    state[2] = state[2] + 1
                state[1] = state[1] + 1
            if char_at(state[0], state[1]) != quote_character
                compile_error("E1003", start_line, "unterminated string", "close the string with a matching " + quote_character)
            string_value = substring(state[0], string_start, state[1])
            state[1] = state[1] + 1
            append(tokens, ["STRING", string_value, start_line])
            continue

        if is_digit(character)
            while is_digit(char_at(state[0], state[1]))
                state[1] = state[1] + 1
            append(tokens, ["NUMBER", substring(state[0], start_position, state[1]), start_line])
            continue

        if is_identifier_start(character)
            while is_identifier_part(char_at(state[0], state[1]))
                state[1] = state[1] + 1
            identifier = substring(state[0], start_position, state[1])
            append(tokens, [keyword_type(identifier), identifier, start_line])
            continue

        next_character = char_at(state[0], state[1] + 1)
        if character == "="
            if next_character == "="
                append(tokens, ["EQUAL_EQUAL", "==", start_line])
                state[1] = state[1] + 2
            else
                append(tokens, ["EQUAL", "=", start_line])
                state[1] = state[1] + 1
            continue
        if character == "!"
            if next_character == "="
                append(tokens, ["BANG_EQUAL", "!=", start_line])
                state[1] = state[1] + 2
                continue
            compile_error("E1004", start_line, "unexpected character '!'", "use 'not' to negate a boolean, or '!=' to compare")
        if character == "<"
            if next_character == "="
                append(tokens, ["LESS_EQUAL", "<=", start_line])
                state[1] = state[1] + 2
            else
                append(tokens, ["LESS", "<", start_line])
                state[1] = state[1] + 1
            continue
        if character == ">"
            if next_character == "="
                append(tokens, ["GREATER_EQUAL", ">=", start_line])
                state[1] = state[1] + 2
            else
                append(tokens, ["GREATER", ">", start_line])
                state[1] = state[1] + 1
            continue

        if character == "("
            append(tokens, ["LEFT_PAREN", character, start_line])
        elif character == ")"
            append(tokens, ["RIGHT_PAREN", character, start_line])
        elif character == ","
            append(tokens, ["COMMA", character, start_line])
        elif character == "+"
            append(tokens, ["PLUS", character, start_line])
        elif character == "-"
            append(tokens, ["MINUS", character, start_line])
        elif character == "*"
            append(tokens, ["STAR", character, start_line])
        elif character == "/"
            append(tokens, ["SLASH", character, start_line])
        elif character == "%"
            append(tokens, ["PERCENT", character, start_line])
        elif character == "["
            append(tokens, ["LEFT_BRACKET", character, start_line])
        elif character == "]"
            append(tokens, ["RIGHT_BRACKET", character, start_line])
        else
            compile_error("E1005", start_line, "unexpected character '" + character + "'", "")
        state[1] = state[1] + 1

    while length(state[4]) > 1
        pop(state[4])
        append(tokens, ["DEDENT", "", state[2]])
    append(tokens, ["EOF", "", state[2]])
    return tokens

fun current_type()
    return token_at(parser_tokens, parser_state[0])[0]

fun current_token()
    return token_at(parser_tokens, parser_state[0])

fun advance_token()
    previous = current_token()
    if current_type() != "EOF"
        parser_state[0] = parser_state[0] + 1
    parser_state[1] = previous
    return previous

fun match_token(kind)
    if current_type() == kind
        advance_token()
        return true
    return false

fun parse_error(message)
    line = current_token()[2]
    if current_type() == "EOF" or current_type() == "INDENT" or current_type() == "DEDENT"
        line = parser_state[1][2]
    compile_error("E2001", line, message, "")
    return none

fun consume_token(kind, message)
    if current_type() != kind
        parse_error(message)
    return advance_token()

fun parse_array_literal()
    elements = []
    if current_type() != "RIGHT_BRACKET"
        while true
            append(elements, parse_expression())
            if not match_token("COMMA")
                break
    consume_token("RIGHT_BRACKET", "Expected ']' after array elements.")
    return ["array", elements]

fun parse_call(name, line)
    consume_token("LEFT_PAREN", "Expected '(' after function name.")
    arguments = []
    if current_type() != "RIGHT_PAREN"
        while true
            append(arguments, parse_expression())
            if not match_token("COMMA")
                break
    consume_token("RIGHT_PAREN", "Expected ')' after function arguments.")
    return ["call", name, arguments, line]

fun parse_postfix(node)
    while match_token("LEFT_BRACKET")
        index = parse_expression()
        consume_token("RIGHT_BRACKET", "Expected ']' after array index.")
        node = ["index", node, index]
    return node

fun parse_primary()
    node = none
    token = none
    name = ""
    if match_token("LEFT_PAREN")
        node = parse_expression()
        consume_token("RIGHT_PAREN", "Expected ')' after expression.")
        return parse_postfix(node)
    if match_token("LEFT_BRACKET")
        node = parse_array_literal()
        return parse_postfix(node)
    if current_type() == "STRING"
        token = advance_token()
        return parse_postfix(["string", token[1]])
    if current_type() == "NUMBER"
        token = advance_token()
        return parse_postfix(["integer", token[1]])
    if match_token("TRUE")
        return parse_postfix(["boolean", true])
    if match_token("FALSE")
        return parse_postfix(["boolean", false])
    if match_token("NONE")
        return parse_postfix(["none"])
    if match_token("MINUS")
        node = ["unary", "-", parse_primary()]
        return parse_postfix(node)
    if match_token("NOT")
        node = ["unary", "not", parse_primary()]
        return parse_postfix(node)
    if current_type() == "IDENTIFIER"
        token = advance_token()
        if current_type() == "LEFT_PAREN"
            node = parse_call(token[1], token[2])
        else
            node = ["variable", token[1], token[2]]
        return parse_postfix(node)
    parse_error("Expected an expression.")
    return ["none"]

fun parse_multiplication()
    left = parse_primary()
    while current_type() == "STAR" or current_type() == "SLASH" or current_type() == "PERCENT"
        operator = advance_token()[1]
        right = parse_primary()
        left = ["binary", operator, left, right]
    return left

fun parse_addition()
    left = parse_multiplication()
    while current_type() == "PLUS" or current_type() == "MINUS"
        operator = advance_token()[1]
        right = parse_multiplication()
        left = ["binary", operator, left, right]
    return left

fun parse_comparison()
    left = parse_addition()
    while current_type() == "EQUAL_EQUAL" or current_type() == "BANG_EQUAL" or current_type() == "LESS" or current_type() == "LESS_EQUAL" or current_type() == "GREATER" or current_type() == "GREATER_EQUAL"
        operator = advance_token()[1]
        right = parse_addition()
        left = ["binary", operator, left, right]
    return left

fun parse_not()
    if match_token("NOT")
        return ["unary", "not", parse_not()]
    return parse_comparison()

fun parse_and()
    left = parse_not()
    while match_token("AND")
        right = parse_not()
        left = ["binary", "and", left, right]
    return left

fun parse_or()
    left = parse_and()
    while match_token("OR")
        right = parse_and()
        left = ["binary", "or", left, right]
    return left

fun parse_expression()
    return parse_or()

fun parse_block()
    consume_token("INDENT", "Expected an indented block.")
    statements = []
    while current_type() != "DEDENT" and current_type() != "EOF"
        append(statements, parse_statement())
    consume_token("DEDENT", "Expected end of block.")
    return ["block", statements]

fun parse_optional_else()
    if match_token("ELIF")
        line = parser_state[1][2]
        condition = parse_expression()
        body = parse_block()
        return ["if", condition, body, parse_optional_else(), line]
    if match_token("ELSE")
        return parse_block()
    return none

fun parse_if_after_keyword()
    condition = parse_expression()
    body = parse_block()
    return ["if", condition, body, parse_optional_else()]

fun parse_function_after_keyword()
    name_token = consume_token("IDENTIFIER", "Expected a function name.")
    parameters = []
    if match_token("LEFT_PAREN")
        if current_type() != "RIGHT_PAREN"
            while true
                parameter = consume_token("IDENTIFIER", "Expected parameter name.")
                append(parameters, parameter[1])
                if not match_token("COMMA")
                    break
        consume_token("RIGHT_PAREN", "Expected ')' after parameters.")
    body = parse_block()
    return ["function", name_token[1], parameters, body]

# Every statement node ends with the line it starts on.
fun parse_statement()
    line = current_token()[2]
    node = parse_statement_node()
    append(node, line)
    return node

fun parse_statement_node()
    if match_token("FUNCTION")
        return parse_function_after_keyword()
    if match_token("IF")
        return parse_if_after_keyword()
    if match_token("WHILE")
        condition = parse_expression()
        return ["while", condition, parse_block()]
    if match_token("RETURN")
        return ["return", parse_expression()]
    if match_token("BREAK")
        return ["break"]
    if match_token("CONTINUE")
        return ["continue"]

    if current_type() != "IDENTIFIER"
        parse_error("Expected a statement.")
    name_token = advance_token()
    if match_token("EQUAL")
        return ["assign", name_token[1], parse_expression()]
    if current_type() == "LEFT_PAREN"
        return parse_call(name_token[1], name_token[2])
    if current_type() == "LEFT_BRACKET"
        lvalue = parse_postfix(["variable", name_token[1], name_token[2]])
        consume_token("EQUAL", "Expected '=' after indexed array expression.")
        return ["index_assign", lvalue, parse_expression()]
    parse_error("Expected '=' or '(' after identifier.")
    return ["none"]

fun parse_program()
    statements = []
    while current_type() != "EOF"
        append(statements, parse_statement())
    return ["program", statements]

# ---------------------------------------------------------------------------
# Code generation
#
# Variables are resolved at compile time. Syger is lexically scoped: a
# function sees its parameters, its own locals and the program's globals.
# Globals are names assigned directly at the top level of the program; they
# become C globals. Every other variable becomes a C local. Functions and
# builtins are called directly. Generated code relies on GNU statement
# expressions ({ ... }) to fix left-to-right evaluation order.
#
# All compiler state lives in global arrays that functions mutate in place
# (index assignment and array builtins), because assigning a global name
# inside a function creates a new local instead.
# ---------------------------------------------------------------------------

fun fresh_name(prefix)
    name_counter[0] = name_counter[0] + 1
    return prefix + to_string(name_counter[0])

fun spaces(count)
    result = ""
    i = 0
    while i < count
        result = result + "    "
        i = i + 1
    return result

fun c_quote(text)
    result = quote_character
    backslash = chr(92)
    i = 0
    while i < length(text)
        character = char_at(text, i)
        if character == quote_character
            result = result + backslash + quote_character
        elif character == backslash
            result = result + backslash + backslash
        elif character == NL
            result = result + backslash + "n"
        elif character == chr(9)
            result = result + backslash + "t"
        elif character == chr(13)
            result = result + backslash + "r"
        elif character == "?"
            result = result + backslash + "?"
        else
            result = result + character
        i = i + 1
    return result + quote_character

fun join_codes(codes)
    return join(codes, ", ")

# ---- pre-pass: collect functions and globals ------------------------------

fun collect_functions(statements)
    i = 0
    while i < length(statements)
        node = statements[i]
        kind = node[0]
        if kind == "function"
            if contains(function_names, node[1])
                compile_error("E3006", node[4], "function '" + node[1] + "' is defined more than once", "rename one of the functions")
            append(function_names, node[1])
            append(function_nodes, node)
            collect_functions(node[3][1])
        elif kind == "if"
            collect_if_functions(node)
        elif kind == "while"
            collect_functions(node[2][1])
        i = i + 1
    return none

fun collect_if_functions(node)
    collect_functions(node[2][1])
    other = node[3]
    if type_of(other) != "none"
        if other[0] == "block"
            collect_functions(other[1])
        else
            collect_if_functions(other)
    return none

fun collect_globals(statements)
    i = 0
    while i < length(statements)
        node = statements[i]
        if node[0] == "assign"
            if not contains(global_names, node[1])
                append(global_names, node[1])
        i = i + 1
    return none

# ---- scopes ---------------------------------------------------------------

fun push_scope(is_loop)
    append(scope_names, [])
    append(scope_cnames, [])
    append(scope_is_loop, is_loop)
    return none

fun pop_scope()
    pop(scope_names)
    pop(scope_cnames)
    pop(scope_is_loop)
    return none

fun reset_scopes()
    clear(scope_names)
    clear(scope_cnames)
    clear(scope_is_loop)
    return none

fun declare_local(name)
    cname = fresh_name("l_" + name + "_")
    top = length(scope_names) - 1
    append(scope_names[top], name)
    append(scope_cnames[top], cname)
    return cname

fun lookup_local(name)
    k = length(scope_names) - 1
    while k >= 0
        i = index_of(scope_names[k], name)
        if i >= 0
            return scope_cnames[k][i]
        k = k - 1
    return ""

fun is_global(name)
    return contains(global_names, name)

fun visible_names()
    names = []
    k = 0
    while k < length(scope_names)
        i = 0
        while i < length(scope_names[k])
            append(names, scope_names[k][i])
            i = i + 1
        k = k + 1
    i = 0
    while i < length(global_names)
        append(names, global_names[i])
        i = i + 1
    return names

fun undefined_variable(name)
    compile_error("E3001", error_line[0], "variable '" + name + "' is not defined", suggestion(name, visible_names(), "assign a value to it first, e.g. " + name + " = 0"))
    return ""

fun emit_variable_read(name)
    local = lookup_local(name)
    if local != ""
        return "syger_retain(" + local + ")"
    if is_global(name)
        return "syger_global_get(&g_" + name + ", " + c_quote(name) + ")"
    return undefined_variable(name)

fun emit_variable_ptr(name)
    local = lookup_local(name)
    if local != ""
        return "&" + local
    if is_global(name)
        return "syger_global_ptr(&g_" + name + ", " + c_quote(name) + ")"
    return undefined_variable(name)

# Releases for scopes from the top of the stack down to (and including) the
# scope at index stop.
fun emit_releases_until(stop, level)
    result = ""
    k = length(scope_cnames) - 1
    while k >= stop
        names = scope_cnames[k]
        i = length(names) - 1
        while i >= 0
            result = result + spaces(level) + "syger_release(" + names[i] + ");" + NL
            i = i - 1
        k = k - 1
    return result

fun innermost_loop_scope()
    k = length(scope_is_loop) - 1
    while k >= 0
        if scope_is_loop[k]
            return k
        k = k - 1
    return -1

# ---- expressions ----------------------------------------------------------

fun string_literal(text)
    i = index_of(literal_texts, text)
    if i < 0
        append(literal_texts, text)
        i = length(literal_texts) - 1
    return "lit_" + to_string(i)

fun is_simple(node)
    kind = node[0]
    return kind == "string" or kind == "integer" or kind == "boolean" or kind == "none" or kind == "variable"

fun all_simple(nodes)
    i = 0
    while i < length(nodes)
        if not is_simple(nodes[i])
            return false
        i = i + 1
    return true

# Evaluates nodes left to right. Returns [prelude, codes]: the prelude
# declares temporaries, codes holds one C expression per node.
fun emit_sequenced(nodes, force_temps)
    prelude = ""
    codes = []
    use_temps = force_temps or not all_simple(nodes)
    i = 0
    while i < length(nodes)
        code = emit_expression(nodes[i])
        if use_temps
            temp = fresh_name("t")
            prelude = prelude + "SygerValue " + temp + " = " + code + "; "
            append(codes, temp)
        else
            append(codes, code)
        i = i + 1
    return [prelude, codes]

fun wrap_sequenced(prelude, expression)
    if prelude == ""
        return expression
    return "({ " + prelude + expression + "; })"

fun is_lvalue(node)
    if node[0] == "variable"
        return true
    if node[0] == "index"
        return is_lvalue(node[1])
    return false

fun lvalue_base(node)
    if node[0] == "variable"
        return node[1]
    return lvalue_base(node[1])

fun lvalue_indexes(node)
    if node[0] == "variable"
        return []
    result = lvalue_indexes(node[1])
    append(result, node[2])
    return result

# Pointer to an lvalue. mutable makes each array along the path unique.
fun emit_place(base, index_codes, mutable)
    pointer = emit_variable_ptr(base)
    function_name = "syger_elem_ptr("
    if mutable
        function_name = "syger_index_ptr("
    i = 0
    while i < length(index_codes)
        pointer = function_name + pointer + ", " + index_codes[i] + ")"
        i = i + 1
    return pointer

fun binary_function(operator)
    if operator == "+"
        return "syger_add"
    elif operator == "-"
        return "syger_sub"
    elif operator == "*"
        return "syger_mul"
    elif operator == "/"
        return "syger_div"
    elif operator == "%"
        return "syger_mod"
    elif operator == "=="
        return "syger_eq"
    elif operator == "!="
        return "syger_ne"
    elif operator == "<"
        return "syger_lt"
    elif operator == "<="
        return "syger_le"
    elif operator == ">"
        return "syger_gt"
    elif operator == ">="
        return "syger_ge"
    fail("Compile error: unsupported operator " + operator)
    return ""

fun arity_help(name)
    function_index = index_of(function_names, name)
    if function_index < 0
        return ""
    return "'" + name + "' is defined as " + name + "(" + join(function_nodes[function_index][2], ", ") + ")"

fun check_arity(name, expected, actual)
    if expected != actual
        label = name
        if contains(function_names, name) and not contains(builtin_names, name)
            label = "function '" + name + "'"
        compile_error("E3003", error_line[0], label + " expects " + to_string(expected) + " argument(s), got " + to_string(actual), arity_help(name))
    return none

fun emit_call(node)
    name = node[1]
    arguments = node[2]
    if name == "print" or name == "eprint"
        result = "({ "
        i = 0
        while i < length(arguments)
            result = result + "syger_b_" + name + "(" + emit_expression(arguments[i]) + "); "
            i = i + 1
        return result + "syger_int(0); })"
    builtin = index_of(builtin_names, name)
    if builtin >= 0
        check_arity(name, builtin_arities[builtin], length(arguments))
        if contains(mutator_names, name)
            target = arguments[0]
            if not is_lvalue(target)
                compile_error("E3010", error_line[0], name + " needs a variable or indexed variable as its first argument", "store the array in a variable first, e.g. items = ...; " + name + "(items, ...)")
            rest = slice(arguments, 1, length(arguments))
            values = emit_sequenced(rest, true)
            indexes = emit_sequenced(lvalue_indexes(target), false)
            call_arguments = [emit_place(lvalue_base(target), indexes[1], true)]
            i = 0
            while i < length(values[1])
                append(call_arguments, values[1][i])
                i = i + 1
            return wrap_sequenced(values[0] + indexes[0], "syger_b_" + name + "(" + join_codes(call_arguments) + ")")
        sequenced = emit_sequenced(arguments, false)
        return wrap_sequenced(sequenced[0], "syger_b_" + name + "(" + join_codes(sequenced[1]) + ")")
    function_index = index_of(function_names, name)
    if function_index < 0
        all_functions = slice(builtin_names, 0, length(builtin_names))
        i = 0
        while i < length(function_names)
            append(all_functions, function_names[i])
            i = i + 1
        compile_error("E3002", error_line[0], "function '" + name + "' is not defined", suggestion(name, all_functions, "define it with: fun " + name + "(parameters)"))
    check_arity(name, length(function_nodes[function_index][2]), length(arguments))
    sequenced = emit_sequenced(arguments, false)
    return wrap_sequenced(sequenced[0], "f_" + name + "(" + join_codes(sequenced[1]) + ")")

fun emit_expression(node)
    kind = node[0]
    if kind == "string"
        return string_literal(node[1])
    if kind == "integer"
        return "syger_int(" + node[1] + "L)"
    if kind == "boolean"
        if node[1]
            return "syger_bool(1)"
        return "syger_bool(0)"
    if kind == "none"
        return "syger_none()"
    if kind == "variable"
        error_line[0] = node[2]
        return emit_variable_read(node[1])
    if kind == "array"
        elements = node[1]
        if length(elements) == 0
            return "syger_array_new(0, NULL)"
        sequenced = emit_sequenced(elements, length(elements) > 1)
        return wrap_sequenced(sequenced[0], "syger_array_new(" + to_string(length(elements)) + ", (SygerValue[]){" + join_codes(sequenced[1]) + "})")
    if kind == "index"
        if is_lvalue(node)
            indexes = emit_sequenced(lvalue_indexes(node), false)
            return wrap_sequenced(indexes[0], "syger_retain(*" + emit_place(lvalue_base(node), indexes[1], false) + ")")
        sequenced = emit_sequenced([node[1], node[2]], true)
        return wrap_sequenced(sequenced[0], "syger_index(" + join_codes(sequenced[1]) + ")")
    if kind == "call"
        error_line[0] = node[3]
        return emit_call(node)
    if kind == "unary"
        if node[1] == "not"
            return "syger_not(" + emit_expression(node[2]) + ")"
        return "syger_neg(" + emit_expression(node[2]) + ")"
    if kind == "binary"
        operator = node[1]
        if operator == "and"
            return "syger_bool(syger_logic_operand(" + emit_expression(node[2]) + ", " + quote_character + "and" + quote_character + ") && syger_logic_operand(" + emit_expression(node[3]) + ", " + quote_character + "and" + quote_character + "))"
        if operator == "or"
            return "syger_bool(syger_logic_operand(" + emit_expression(node[2]) + ", " + quote_character + "or" + quote_character + ") || syger_logic_operand(" + emit_expression(node[3]) + ", " + quote_character + "or" + quote_character + "))"
        sequenced = emit_sequenced([node[2], node[3]], false)
        return wrap_sequenced(sequenced[0], binary_function(operator) + "(" + join_codes(sequenced[1]) + ")")
    fail("Compile error: unknown expression node " + kind)
    return ""

# ---- statements -----------------------------------------------------------

fun variable_exists(name)
    if lookup_local(name) != ""
        return true
    if in_function[0]
        return false
    return contains(declared_globals, name)

fun emit_assign(node, level)
    prefix = spaces(level)
    name = node[1]
    value = node[2]
    if variable_exists(name) and value[0] == "binary" and value[1] == "+" and value[2][0] == "variable" and value[2][1] == name
        temp = fresh_name("t")
        return prefix + "{ SygerValue " + temp + " = " + emit_expression(value[3]) + "; syger_add_assign(" + emit_variable_ptr(name) + ", " + temp + "); }" + NL
    code = emit_expression(value)
    local = lookup_local(name)
    if local != ""
        return prefix + "syger_set(&" + local + ", " + code + ");" + NL
    if not in_function[0]
        if length(scope_names) == 0 or contains(declared_globals, name)
            if not contains(declared_globals, name)
                append(declared_globals, name)
            return prefix + "syger_set(&g_" + name + ", " + code + ");" + NL
    return prefix + "SygerValue " + declare_local(name) + " = " + code + ";" + NL

fun emit_index_assign(node, level)
    target = node[1]
    value = emit_sequenced([node[2]], true)
    indexes = emit_sequenced(lvalue_indexes(target), false)
    place = emit_place(lvalue_base(target), indexes[1], true)
    return spaces(level) + "{ " + value[0] + indexes[0] + "syger_set(" + place + ", " + value[1][0] + "); }" + NL

fun emit_block(statements, level, is_loop)
    push_scope(is_loop)
    body = emit_statement_list(statements, level + 1)
    body = body + emit_releases_until(length(scope_names) - 1, level + 1)
    pop_scope()
    return spaces(level) + "{" + NL + body + spaces(level) + "}" + NL

fun emit_if(node, level)
    error_line[0] = node[4]
    result = line_marker(node[4], spaces(level))
    result = result + spaces(level) + "if (syger_truth(" + emit_expression(node[1]) + "))" + NL
    result = result + emit_block(node[2][1], level, false)
    other = node[3]
    if type_of(other) != "none"
        result = result + spaces(level) + "else" + NL
        if other[0] == "block"
            result = result + emit_block(other[1], level, false)
        else
            result = result + spaces(level) + "{" + NL + emit_if(other, level + 1) + spaces(level) + "}" + NL
    return result

fun line_marker(line, prefix)
    return prefix + "syger_line = " + to_string(line) + ";" + NL

fun emit_statement(node, level)
    kind = node[0]
    prefix = spaces(level)
    if kind == "block"
        return emit_block(node[1], level, false)
    line = node[length(node) - 1]
    error_line[0] = line
    if kind == "assign" or kind == "index_assign" or kind == "call" or kind == "return"
        return line_marker(line, prefix) + emit_statement_body(node, level)
    return emit_statement_body(node, level)

fun emit_statement_body(node, level)
    kind = node[0]
    prefix = spaces(level)
    if kind == "assign"
        return emit_assign(node, level)
    if kind == "index_assign"
        return emit_index_assign(node, level)
    if kind == "call"
        return prefix + "syger_release(" + emit_expression(node) + ");" + NL
    if kind == "function"
        return ""
    if kind == "if"
        return emit_if(node, level)
    if kind == "while"
        result = prefix + "while ((syger_line = " + to_string(node[3]) + "), syger_truth(" + emit_expression(node[1]) + "))" + NL
        return result + emit_block(node[2][1], level, true)
    if kind == "block"
        return emit_block(node[1], level, false)
    if kind == "return"
        if not in_function[0]
            compile_error("E3005", error_line[0], "return outside a function", "return can only be used inside a fun block")
        temp = fresh_name("r")
        result = prefix + "{" + NL
        result = result + prefix + "    SygerValue " + temp + " = " + emit_expression(node[1]) + ";" + NL
        result = result + emit_releases_until(0, level + 1)
        result = result + prefix + "    syger_leave();" + NL
        return result + prefix + "    return " + temp + ";" + NL + prefix + "}" + NL
    if kind == "break" or kind == "continue"
        loop_scope = innermost_loop_scope()
        if loop_scope < 0
            compile_error("E3004", error_line[0], "break or continue outside a loop", "break and continue can only be used inside a while loop")
        return prefix + "{" + NL + emit_releases_until(loop_scope, level + 1) + prefix + "    " + kind + ";" + NL + prefix + "}" + NL
    fail("Compile error: unsupported statement " + kind)
    return ""

fun emit_statement_list(statements, level)
    result = ""
    i = 0
    while i < length(statements)
        result = result + emit_statement(statements[i], level)
        i = i + 1
    return result

# ---- functions and program ------------------------------------------------

fun emit_signature(node)
    parameters = node[2]
    if length(parameters) == 0
        return "SygerValue f_" + node[1] + "(void)"
    declarations = []
    i = 0
    while i < length(parameters)
        append(declarations, "SygerValue " + declare_local(parameters[i]))
        i = i + 1
    return "SygerValue f_" + node[1] + "(" + join_codes(declarations) + ")"

fun emit_function(node)
    reset_scopes()
    in_function[0] = true
    push_scope(false)
    result = emit_signature(node) + NL + "{" + NL
    result = result + "    syger_enter(" + c_quote(node[1]) + ");" + NL
    result = result + emit_statement_list(node[3][1], 1)
    result = result + emit_releases_until(0, 1)
    result = result + "    syger_leave();" + NL
    result = result + "    return syger_int(0);" + NL + "}" + NL + NL
    pop_scope()
    return result

fun emit_prototype(node)
    parameters = node[2]
    if length(parameters) == 0
        return "SygerValue f_" + node[1] + "(void);" + NL
    declarations = []
    i = 0
    while i < length(parameters)
        append(declarations, "SygerValue")
        i = i + 1
    return "SygerValue f_" + node[1] + "(" + join_codes(declarations) + ");" + NL

fun emit_c(program)
    statements = program[1]
    collect_functions(statements)
    collect_globals(statements)

    function_code = ""
    i = 0
    while i < length(function_nodes)
        function_code = function_code + emit_function(function_nodes[i])
        i = i + 1

    reset_scopes()
    in_function[0] = false
    main_code = emit_statement_list(statements, 1)

    quote = quote_character
    result = "/* Generated by the Syger compiler. */" + NL
    result = result + "#include " + quote + "native_runtime.h" + quote + NL
    result = result + "#include <stddef.h>" + NL + NL

    i = 0
    while i < length(global_names)
        result = result + "static SygerValue g_" + global_names[i] + ";" + NL
        i = i + 1
    i = 0
    while i < length(literal_texts)
        result = result + "static SygerValue lit_" + to_string(i) + ";" + NL
        i = i + 1
    result = result + NL

    i = 0
    while i < length(function_nodes)
        result = result + emit_prototype(function_nodes[i])
        i = i + 1
    result = result + NL

    result = result + "static void syger_init_literals(void)" + NL + "{" + NL
    i = 0
    while i < length(literal_texts)
        text = literal_texts[i]
        result = result + "    lit_" + to_string(i) + " = syger_string_literal(" + c_quote(text) + ", " + to_string(length(text)) + ");" + NL
        i = i + 1
    result = result + "}" + NL + NL

    result = result + function_code
    result = result + "int main(int argc, char **argv)" + NL + "{" + NL
    result = result + "    syger_runtime_set_arguments(argc, argv);" + NL
    result = result + "    syger_source_path = " + c_quote(source_path) + ";" + NL
    result = result + "    syger_init_literals();" + NL
    result = result + main_code
    result = result + "    syger_runtime_shutdown();" + NL
    result = result + "    return 0;" + NL + "}" + NL
    return result

# ---------------------------------------------------------------------------
# Driver
# ---------------------------------------------------------------------------

# Runtime character constants. chr() is needed because the current Syger string
# syntax intentionally does not support escaped quote characters.
quote_character = chr(34)
NL = chr(10)
BS = chr(92)
digit_chars = string_chars("0123456789")
lowercase_chars = string_chars("abcdefghijklmnopqrstuvwxyz")
uppercase_chars = string_chars("ABCDEFGHIJKLMNOPQRSTUVWXYZ")

builtin_names = ["eprint", "exit", "print", "type_of", "fail", "args", "read_file", "write_file", "char_at", "substring", "chr", "to_string", "length", "token_at", "contains", "index_of", "slice", "join", "sum", "min", "max", "first", "last", "append", "pop", "insert", "remove", "clear", "reverse", "sort"]
builtin_arities = [-1, 1, -1, 1, 1, 0, 1, 2, 2, 3, 1, 1, 1, 2, 2, 2, 3, 2, 1, 1, 1, 1, 1, 2, 1, 3, 2, 1, 1, 1]
mutator_names = ["append", "pop", "insert", "remove", "clear", "reverse", "sort"]

# Compiler state (mutated in place by the code generator).
name_counter = [0]
function_names = []
function_nodes = []
global_names = []
declared_globals = []
literal_texts = []
scope_names = []
scope_cnames = []
scope_is_loop = []
in_function = [false]
error_line = [0]

arguments = args()
if length(arguments) != 2
    eprint("usage: Syger selfhost/compiler.sg <input.sg> <output.c>")
    exit(2)
source_path = arguments[0]
output_path = arguments[1]
source_text = read_file(source_path)
scanned_tokens = scan_tokens(source_text)
parser_tokens = scanned_tokens
parser_state = [0, ["EOF", "", 1]]
parsed_program = parse_program()
generated_c = emit_c(parsed_program)
if not write_file(output_path, generated_c)
    eprint("error: could not write generated C file: " + output_path)
    exit(1)
print("Generated C source: " + output_path)
